# Normalize all text files to LF in the repo, native on checkout
* text=auto eol=lf

# Ensure these are always LF
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf

# Binary files
*.exe binary
*.dll binary
*.nupkg binary
